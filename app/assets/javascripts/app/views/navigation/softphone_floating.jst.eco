<div class="softphone-floating js-softphoneFloating" 
style="position: fixed;bottom: 11%;right: 2%; display:flex; flex-direction: column; justify-content: center; 
align-items:center; z-index: 400">
  <div class="softphone-floating__panel js-softphonePanel" style="position: relative;">
    <iframe class="softphone-floating__iframe"
            id="saraphone_iframe"
            src="https://beds2b-softphone.senator.tools"
            allow="microphone; camera; autoplay; notifications, focus-without-user-activation"
            style="height: 62rem;border: none;">
    </iframe>
  </div>

  <button class="btn-softphone js-softphoneToggle"
          title="Softphone">
    <%- @Icon('phone') %>
  </button>
</div>

