<div class="softphone-floating js-softphoneFloating" style="position: fixed;top: 20%;right: 17.5%;">
  <div class="softphone-floating__panel js-softphonePanel">
    <iframe class="softphone-floating__iframe"
            id="saraphone_iframe"
            src="https://beds2b-softphone.senator.tools"
            allow="microphone; camera; autoplay; notifications"
            style="height: 70rem;border: none;">
    </iframe>
  </div>
</div>

<button class="btn-softphone js-softphoneToggle"
          title="Softphone">
  <%- @Icon('phone') %>
</button>